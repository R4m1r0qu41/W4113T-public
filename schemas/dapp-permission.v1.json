{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.dev/schemas/dapp-permission.v1.json",
  "title": "DappPermission",
  "description": "Connection grant for a dapp/caller: accounts disclosed, chain scope, access class, expiry, revocation. Read-only and signing are separate grants with independent lifecycles.",
  "type": "object",
  "required": ["schema_version", "permission_id", "caller", "chain_id", "access", "accounts", "granted_at", "expires_at", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "permission_id": { "type": "string", "format": "uuid" },
    "caller": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["dapp", "cli", "desktop", "agent", "unknown"] },
        "origin": { "type": "string", "minLength": 1 },
        "app_id": { "type": "string", "minLength": 1 },
        "capsule_id": { "type": "string" }
      }
    },
    "chain_id": { "type": "integer", "minimum": 1 },
    "access": { "enum": ["read_only", "signing"] },
    "accounts": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" } },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time", "description": "mandatory expiry" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["active", "expired", "revoked"] },
    "ext": { "type": "object" }
  }
}
