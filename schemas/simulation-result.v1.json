{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.dev/schemas/simulation-result.v1.json",
  "title": "SimulationResult",
  "description": "Normalized simulation evidence. Always evidence, never a guarantee: provenance, freshness, and a non-empty limitations list are mandatory. Conflicting multi-provider results are represented at the bundle level (risk-evidence-bundle / SimulationEvidence), each provider producing one of these.",
  "type": "object",
  "required": ["schema_version", "simulation_id", "request_id", "simulated_at", "provider", "outcome", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "simulation_id": { "type": "string", "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "simulated_at": { "type": "string", "format": "date-time" },
    "provider": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["local_fork", "local_node", "rpc", "third_party_service", "unknown"] },
        "endpoint_class": { "enum": ["local", "public", "premium", "unknown", null] },
        "version": { "type": ["string", "null"] }
      }
    },
    "block_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "block_number": { "type": ["integer", "null"], "minimum": 0 },
        "chain_id": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "outcome": { "enum": ["success", "revert", "simulation_error"], "description": "simulation_error = the simulation itself failed; pipeline must enter SIMULATION_FAILED, never proceed silently" },
    "revert_reason": { "type": ["string", "null"], "description": "null = reverted with no decodable reason" },
    "balance_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "holder", "before", "after"],
        "additionalProperties": false,
        "properties": {
          "asset": { "type": "string", "description": "'native' or token contract address" },
          "holder": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "before": { "type": ["string", "null"], "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$" },
          "after": { "type": ["string", "null"], "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$" }
        }
      }
    },
    "allowance_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token", "owner", "spender", "before", "after"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "owner": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "spender": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "before": { "type": ["string", "null"], "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$" },
          "after": { "type": ["string", "null"], "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$" }
        }
      }
    },
    "gas_used": { "type": ["string", "null"], "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "mandatory, non-empty: e.g. state-drift, conditional-contract-behavior, single-provider, oracle-drift"
    },
    "ext": { "type": "object" }
  }
}
