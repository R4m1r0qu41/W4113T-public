{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.dev/schemas/wallet-capability.v1.json",
  "title": "WalletCapability",
  "description": "Two roles: (1) capability advertisement — what this wallet supports; (2) $defs/capability_grant — a narrow, expiring, revocable grant of authority to a subject (BS §7.2). Grants are references validated wallet-side, not bearer secrets.",
  "type": "object",
  "required": ["schema_version", "advertised_at", "protocol_versions", "chains", "methods"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "advertised_at": { "type": "string", "format": "date-time" },
    "protocol_versions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "chains": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "methods": { "type": "array", "items": { "type": "string" }, "description": "supported request methods; unlisted methods are rejected, not ignored" },
    "signer_kinds": { "type": "array", "items": { "enum": ["test", "external", "hardware", "watch_only"] } },
    "ext": { "type": "object" },

    "$comment": "instances of capability grants validate against #/$defs/capability_grant"
  },
  "$defs": {
    "capability_grant": {
      "type": "object",
      "required": ["capability_id", "subject", "account", "chain_id", "scope", "issued_at", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "capability_id": { "type": "string", "format": "uuid" },
        "subject": { "type": "string", "minLength": 1, "description": "who holds this capability, e.g. 'cli:local-user', 'dapp:https://example.org', 'agent:trading-assistant'" },
        "account": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "chain_id": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["read_only", "sign_transactions", "sign_messages"], "description": "one scope per grant; multiple scopes = multiple grants (narrowness by construction)" },
        "contracts": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "description": "null = evaluated, unrestricted within policy; non-null restricts targets" },
        "max_value_wei_per_tx": { "type": ["string", "null"], "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time", "description": "mandatory — capabilities always expire" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "requires_user_confirmation": { "type": "boolean", "default": true }
      }
    }
  }
}
