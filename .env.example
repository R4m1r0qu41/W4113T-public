# CipherLayer Wallet — example configuration
# Copy to .env for local overrides. NEVER commit .env. NEVER put real keys here.

# JSON-RPC endpoint of the local development chain (Anvil default).
CIPHERLAYER_RPC_URL=http://127.0.0.1:8545

# Expected chain ID for the dev profile (Anvil default = 31337).
CIPHERLAYER_CHAIN_ID=31337

# Audit log location (JSONL, append-only, hash-chained).
CIPHERLAYER_AUDIT_LOG=./data/audit-log.jsonl

# Policy file used by the CLI (defaults to fixtures/policies/default-policy.json).
CIPHERLAYER_POLICY_FILE=./fixtures/policies/default-policy.json

# Persisted permission grants (JSON; grants are not secrets, status re-validated on use).
CIPHERLAYER_PERMISSIONS_FILE=./data/permissions.json

# TEST SIGNER ONLY — MOCKED VAULT BOUNDARY.
# This must only ever be a well-known Anvil development key. Real keys are forbidden.
# Anvil account #0 (publicly known, worthless):
CIPHERLAYER_TEST_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Browser-connect transport socket (protocol v0.2, `connect serve`)
# Same-user peer auth via 0700 dir; never place on shared/world-readable paths.
# CIPHERLAYER_CONNECT_SOCKET=./data/browser-connect.sock

# Real FPL/Scam Guard detector for the risk step (subprocess over the pinned
# contract). Unset = labeled mock detector.
# CIPHERLAYER_FPL_BIN=../scam-guard/target/debug/scam-guard

# QuickNode (or any premium) Sepolia RPC — full authenticated URL incl. token.
# Never commit the real value; the registry only names this variable.
# CIPHERLAYER_QUICKNODE_SEPOLIA_URL=https://<your-endpoint>.quiknode.pro/<token>/

# Real external-signer key (Sepolia testnet only). Load via
# tools/metamask-lifecycle-harness/load-cipherlayer-test-key.zsh — never set by hand,
# never commit. Read only at sign time by cipherlayer-vault::LocalKeyExternalSigner.
# CIPHERLAYER_EXTERNAL_SIGNER_KEY=  (exported by the loader, this shell only)
# CIPHERLAYER_EXTERNAL_SIGNER_FROM=0x<your test account>
